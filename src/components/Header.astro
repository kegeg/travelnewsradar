---
import { CATEGORIES, categorySlug } from '../consts';
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="TravelNewsRadar home">
      <img
        class="brand__logo"
        src="/brand/tnr-mark.png"
        alt=""
        width="160"
        height="72"
        decoding="async"
      />
      <span class="brand__name">Travel News Radar</span>
    </a>
    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span class="nav-toggle__bars" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
      <span class="sr-only">Menu</span>
    </button>
    <nav class="site-nav" id="site-nav" aria-label="Primary" data-site-nav>
      <a href="/">Latest</a>
      {
        CATEGORIES.map((category) => (
          <a href={`/category/${categorySlug(category)}/`}>{category}</a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');
  const toggle = document.querySelector('[data-nav-toggle]');
  const nav = document.querySelector('[data-site-nav]');

  if (header instanceof HTMLElement && toggle instanceof HTMLButtonElement && nav instanceof HTMLElement) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
      header.classList.toggle('is-nav-open', open);
    };

    const close = () => setOpen(false);

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      setOpen(open);
    });

    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', close);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Node)) return;
      if (!header.contains(event.target)) close();
    });

    const mq = window.matchMedia('(min-width: 761px)');
    const syncDesktop = () => {
      if (mq.matches) close();
    };
    mq.addEventListener('change', syncDesktop);
  }
</script>
