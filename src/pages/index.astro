---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryCard from '../components/StoryCard.astro';
import {
  CATEGORIES,
  categorySlug,
  SITE_NAME,
  SITE_TAGLINE,
  type Category,
} from '../consts';

type Article = CollectionEntry<'articles'>;

const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const lead = articles[0];
const featuredRest = articles.slice(1, 4);
const featuredIds = new Set(articles.slice(0, 4).map((a) => a.id));

const remaining = articles.filter((a) => !featuredIds.has(a.id));

const publishedCountByCategory = Object.fromEntries(
  CATEGORIES.map((category) => [
    category,
    articles.filter((a) => a.data.category === category).length,
  ]),
) as Record<Category, number>;

const MERGE_UNTIL = 4;

type HomeSection = {
  title: string;
  seeMoreHref: string | null;
  articles: Article[];
};

const primaryOrder: Category[] = ['Flights', 'Borders', 'Labor', 'Rewards'];
const thinCategories: Category[] = ['Health', 'Advisories'];
const sections: HomeSection[] = [];

for (const category of primaryOrder) {
  const items = remaining
    .filter((a) => a.data.category === category)
    .slice(0, 4);
  if (items.length === 0) continue;
  sections.push({
    title: category,
    seeMoreHref:
      publishedCountByCategory[category] >= 5
        ? `/category/${categorySlug(category)}/`
        : null,
    articles: items,
  });
}

const othersPool: Category[] = [];
for (const category of thinCategories) {
  if (publishedCountByCategory[category] >= MERGE_UNTIL) {
    const items = remaining
      .filter((a) => a.data.category === category)
      .slice(0, 4);
    if (items.length === 0) continue;
    sections.push({
      title: category,
      seeMoreHref:
        publishedCountByCategory[category] >= 5
          ? `/category/${categorySlug(category)}/`
          : null,
      articles: items,
    });
  } else {
    othersPool.push(category);
  }
}

if (othersPool.length > 0) {
  const others = remaining
    .filter((a) => othersPool.includes(a.data.category))
    .slice(0, 4);
  if (others.length > 0) {
    sections.push({
      title: 'Others',
      seeMoreHref: null,
      articles: others,
    });
  }
}
---

<BaseLayout description={`${SITE_TAGLINE}. ${SITE_NAME} covers breaking travel news for travelers.`}>
  <h1 class="sr-only">{SITE_NAME}: {SITE_TAGLINE}</h1>

  {
    articles.length === 0 ? (
      <p>No articles yet.</p>
    ) : (
      <div class="home-feed">
        {lead && (
          <ol class="story-list story-list--lead">
            <StoryCard article={lead} variant="lead" />
          </ol>
        )}
        {featuredRest.length > 0 && (
          <ol class="story-list story-list--grid">
            {featuredRest.map((article) => (
              <StoryCard article={article} variant="card" />
            ))}
          </ol>
        )}
        {sections.map((section) => (
          <section class="home-category">
            <div class="home-category__head">
              <h2 class="home-category__title">{section.title}</h2>
              {section.seeMoreHref && (
                <a class="home-category__more" href={section.seeMoreHref}>
                  See more
                </a>
              )}
            </div>
            <ol class="story-list story-list--row4">
              {section.articles.map((article) => (
                <StoryCard article={article} variant="compact" />
              ))}
            </ol>
          </section>
        ))}
      </div>
    )
  }
</BaseLayout>
